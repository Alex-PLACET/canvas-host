# Installed CMake package configuration for canvas-host.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json CONFIG)
if(@CANVAS_HOST_BUILD_C_API@)
    find_dependency(xeus CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/canvas-host-targets.cmake")

check_required_components(canvas-host)
